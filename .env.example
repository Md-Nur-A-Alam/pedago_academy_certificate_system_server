# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database & Auth (Shared with Client)
MONGODB_URI=mongodb://localhost:27017/pedago_certificate_db
BETTER_AUTH_SECRET=your-better-auth-secret-key-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Image Hosting Services (Dual-provider with auto-fallback)
IMGBB_API_KEY=your_imgbb_api_key
POSTIMAGE_API_KEY=your_postimage_api_key
IMAGE_PROVIDER=auto # auto | postimage | imgbb

# Super Admin Seeding
SEED_SUPER_ADMIN_EMAIL=admin@pedagoacademy.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123456
